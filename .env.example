# Copy to .env and fill in. Never commit .env.

# ---------- general
APP_ENV=local
LOG_LEVEL=INFO

# ---------- postgres
POSTGRES_USER=ramei
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ramei
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ramei:change-me@localhost:5432/ramei

# ---------- redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- object storage (MinIO / S3)
MINIO_ROOT_USER=ramei
MINIO_ROOT_PASSWORD=change-me-too
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ramei-media

# ---------- auth
JWT_SECRET=generate-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ---------- models
MODEL_BUNDLE_DIR=./ml/artifacts/bundles
ACTIVE_MODEL=ramei-rgcmt
INFERENCE_DEVICE=cpu            # cpu | cuda
ASR_MODEL=small.en

# ---------- optional: LLM session summaries (feature disabled when empty)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ---------- frontend (Vite exposes only VITE_* variables to the browser bundle)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/stream
