# Copy to .env and fill in. Never commit .env.
# Every key is optional for local development; defaults live in backend/app/core/config.py.

# ---------- general
# anything other than "local" requires a real JWT_SECRET
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- database (SQLite by default; PostgreSQL via the [postgres] extra, see ADR-0008)
# DATABASE_URL=postgresql+psycopg://ramei:change-me@localhost:5432/ramei
POSTGRES_USER=ramei
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ramei
POSTGRES_PORT=5432

# ---------- auth
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-long-random-string
ACCESS_TOKEN_MINUTES=480

# ---------- uploads / privacy
MAX_UPLOAD_MB=200
MAX_UPLOAD_MINUTES=60
# PRD privacy default: uploads are deleted after analysis
STORE_RAW_MEDIA=false

# ---------- models
MODEL_BUNDLE_DIR=./ml/artifacts/bundles
ACTIVE_MODEL=ramei-rgcmt-1.0.0
# auto | cpu | cuda
INFERENCE_DEVICE=auto
LOAD_MODELS_ON_STARTUP=false

# ---------- optional: LLM session narrative (off when LLM_PROVIDER is empty)
# Only aggregate statistics are sent; transcripts and media never leave the server.
# "" | anthropic   (pip install -e "backend[llm]")
LLM_PROVIDER=
LLM_MODEL=claude-opus-5-5
# or set ANTHROPIC_API_KEY
LLM_API_KEY=
LLM_TIMEOUT_S=20

# ---------- frontend (Vite exposes only VITE_* variables to the browser bundle)
# Defaults to the same-origin /api/v1 (Vite dev proxy / nginx). Set only for split hosting.
# VITE_API_URL=http://localhost:8000/api/v1
